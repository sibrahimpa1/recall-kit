# recall-kit configuration. Copy to .env (never commit .env).

# Where the store lives (markdown + git + index). Docker sets /data/store.
RECALL_HOME=~/.recall-kit

# HTTP server tokens: name:scopes:sha256(secret), separated by ';'
# Create entries with:  rk token new --name laptop --scopes read,write
# Scopes: read, write, forget, admin. Remove an entry + restart = revoked.
RECALL_TOKENS=

# Host header values the HTTP server accepts (DNS-rebinding protection)
RECALL_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,memory.example.com

# Public hostname for Caddy (automatic TLS)
DOMAIN=memory.example.com

# Encrypts backups (scrypt + AES-256-GCM). 12+ chars; store it in a password manager too —
# without it a backup cannot be restored.
RECALL_BACKUP_PASSPHRASE=

# Optional: label written to the audit log for CLI actions
RECALL_ACTOR=cli

# Optional: only for the LLM-in-the-loop eval (evals/llm_eval.py)
ANTHROPIC_API_KEY=
